# ═══════════════════════════════════════════════════════════════
# VDCD Backend — Production Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to /opt/vdcd/.env and fill in real values.
# NEVER commit the real .env file to git!
# ═══════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Docker Image (set by CI/CD) ────────────────────────────────
DOCKER_IMAGE=anhlnp/vdcd-backend
IMAGE_TAG=latest

# ── Database ───────────────────────────────────────────────────
# Use strong password! Generate: openssl rand -base64 24
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vdcd_db
DB_USER=vdcd_user
DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# ── JWT ────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_RANDOM_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ── Mail (SMTP - Gmail) ───────────────────────────────────────
# Create App Password: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=kensarzero13@gmail.com
MAIL_PASSWORD=CHANGE_ME_CREATE_NEW_APP_PASSWORD
MAIL_FROM="VDCD <noreply@doimoisangtaogialai.vn>"
MAIL_ADMIN=kensarzero13@gmail.com
ADMIN_URL=https://admin.doimoisangtaogialai.vn

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://doimoisangtaogialai.vn,https://www.doimoisangtaogialai.vn

# ── Redis ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 16
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── ImageKit CDN ───────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=CHANGE_ME_ROTATE_KEY
IMAGEKIT_PRIVATE_KEY=CHANGE_ME_ROTATE_KEY
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/po0s6zxoj

# ── Google Drive Backup (Optional) ────────────────────────────
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
# BACKUP_CRON=0 2 * * *
# BACKUP_RETAIN_COUNT=30
